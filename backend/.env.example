# Copy to backend/.env and adjust. Never commit the real .env file.
# scripts\setup.ps1 creates backend/.env with a freshly generated secret automatically.

# REQUIRED for stable sessions: random string of at least 32 characters.
# Generate one with:  .venv\Scripts\python -c "import secrets; print(secrets.token_urlsafe(48))"
DOCPREDICT_SECRET_KEY=

# Where the SQLite database and temporary upload files live (default: backend/data)
# DOCPREDICT_DATA_DIR=./data
# DOCPREDICT_DATABASE_URL=sqlite:///./data/docpredict.db
# DOCPREDICT_TEMP_DIR=./data/tmp

# Upload and processing limits
DOCPREDICT_MAX_UPLOAD_MB=10
DOCPREDICT_MAX_PDF_PAGES=200
DOCPREDICT_MAX_TEXT_CHARS=200000

# Session length in minutes
DOCPREDICT_TOKEN_EXPIRE_MINUTES=120

# Comma-separated list of allowed browser origins (the frontend dev/preview server)
DOCPREDICT_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
